# Copy this file to .env and fill in the values. Never commit .env.

# Hugging Face write token (Settings > Access Tokens > "Write"). Used to push the model.
HF_TOKEN=

# Optional. Defaults to <your-username>/sachai-check-urdu-audio-deepfake
HF_REPO_ID=

# Model repo visibility. Set to false to make it public.
HF_PRIVATE=true

# LLM justifier and judge. Any OpenAI-compatible provider works. Defaults are Groq (free key at console.groq.com).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=openai/gpt-oss-120b

# Optional, for the API: a local export folder or a Hugging Face repo id.
# Empty means: newest runs/*/export, then HF_REPO_ID.
SACHAI_MODEL=
